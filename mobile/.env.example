# Where the app finds the Subtrack API. Copy to .env and change it for a real phone.
# The Android emulator reaches the computer it runs on at 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# The "Web application" OAuth client id from Google Cloud, the same value as GOOGLE_CLIENT_ID
# in the backend's .env. Leave it empty to keep Google sign-in switched off.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
