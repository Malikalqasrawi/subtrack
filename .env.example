# Copy to .env and fill in. Never commit .env.

# Signs login tokens. Must be at least 32 characters; generate one with: openssl rand -base64 48
JWT_SECRET=

DB_PASSWORD=

# Encrypts two-factor secrets in the database: openssl rand -base64 32
# Keep it: with another key, two-factor sign-ins stop working.
ENCRYPTION_KEY=

# true on a real server: refuses to start unless emails are really sent and COOKIE_SECURE is true.
# PRODUCTION=true

# Email. Leave these out to use the bundled Mailpit inbox at http://localhost:8025.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=Subtrack <no-reply@yourdomain.com>

# The app answers on this machine only. Set to 0.0.0.0 to reach it from other devices on the
# same network, for example a phone running the mobile app.
# APP_BIND=0.0.0.0

# Set to true when serving over HTTPS.
# COOKIE_SECURE=true

# Sign in with Google / Apple. Leave empty to keep a provider switched off.
# The README explains how to get these.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# APPLE_CLIENT_ID=com.yourdomain.subtrack.web
